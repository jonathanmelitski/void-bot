# Copy to .env and fill in. Never commit .env.
# From https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# Optional: sync slash commands to a single server (updates instantly).
# Leave blank to sync globally (can take up to an hour to propagate).
DISCORD_GUILD_ID=

# Roles allowed to use the /player and /group commands, as comma-separated role IDs
# (Developer Mode on, then Server Settings -> Roles -> right-click -> Copy Role ID).
# Server administrators can always use them.
ADMIN_ROLE_IDS=1533558879164698624

# Optional: category ID to put /group channels under (right-click the category -> Copy Channel ID).
# Leave blank to create them at the top level.
GROUP_CATEGORY_ID=

# Optional: category ID that /group archive moves channels to. Leave blank and the bot creates an
# "Archived groups" category itself. A category holds 50 channels; when this one is full the bot
# makes "Archived groups 2" and so on.
GROUP_ARCHIVE_CATEGORY_ID=

# Throwing-session logging: the channel where tagging the bot logs reports (right-click -> Copy Channel ID)
# and an Anthropic API key (https://platform.claude.com -> API keys). Leave either blank to turn it off.
THROWING_CHANNEL_ID=
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5
# Time zone for reading "yesterday", "this morning", etc.
# TIMEZONE=America/New_York

# Optional: channel the bot posts its errors to (right-click -> Copy Channel ID). Keep it admin-only.
# Leave blank to only log them to the console.
ERRORS_CHANNEL_ID=

# Superadmin requests: people with this role can @mention the bot in this channel to change the
# database in plain English (the bot shows the SQL and waits for a Confirm button). Leave either
# blank to turn it off. Needs ANTHROPIC_API_KEY.
SUPERADMIN_ROLE_ID=
SUPERADMIN_MANAGEMENT_CHANNEL_ID=
# SUPERADMIN_MODEL=claude-opus-5-5

# Set to false to skip syncing slash commands on every startup.
SYNC_COMMANDS_ON_START=true

# Where the SQLite database lives. The default is inside the Docker volume.
# DB_PATH=data/players.db
